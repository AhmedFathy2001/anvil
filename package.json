{
  "name": "anvil",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:migrate": "node scripts/migrate.mjs",
    "data:clog": "node scripts/build-clog-dataset.mjs",
    "data:ca": "node scripts/build-ca-dataset.mjs",
    "data:drops": "node scripts/build-drops-dataset.mjs",
    "data:slayer": "node scripts/build-slayer-dataset.mjs",
    "data:rates": "node scripts/build-rates-dataset.mjs",
    "data:efficiency": "node scripts/build-efficiency-dataset.mjs",
    "verify:efficiency": "tsx scripts/verify-efficiency.mts",
    "db:studio": "drizzle-kit studio",
    "test": "node scripts/test-all.mjs",
    "test:roles": "npx tsx --test tests/clan-roles.test.ts",
    "test:clan": "npx tsx --test tests/clan-host.test.ts",
    "test:db": "npx tsx --test tests/db-semantics.test.ts",
    "test:identity": "npx tsx --test tests/identity-backfill.test.ts",
    "test:lintview": "npx tsx --test tests/lint-view-writes.test.ts",
    "test:eventscope": "npx tsx --test tests/event-scope.test.ts",
    "test:authority": "npx tsx --test tests/clan-authority.test.ts",
    "test:platform": "npx tsx --test tests/platform-authority.test.ts",
    "test:billing": "npx tsx --test tests/billing-webhook.test.ts",
    "test:clancreate": "npx tsx --test tests/clan-create.test.ts",
    "test:clanbans": "npx tsx --test tests/clan-bans.test.ts",
    "test:guests": "npx tsx --test tests/guest-admission.test.ts",
    "test:verification": "npx tsx --test tests/clan-verification.test.ts",
    "test:eventaccess": "npx tsx --test tests/event-access.test.ts",
    "test:seatscope": "npx tsx --test tests/seat-scope.test.ts",
    "test:accountvis": "npx tsx --test tests/account-visibility.test.ts",
    "test:clanpaths": "npx tsx --test tests/clan-paths.test.ts",
    "test:adminaccess": "npx tsx --test tests/admin-access.test.ts",
    "test:security": "node --experimental-strip-types --test tests/client-ip.test.ts tests/secret-box.test.ts",
    "test:stages": "node --experimental-strip-types --test tests/board-misconfig.test.ts tests/draft-control.test.ts tests/event-stage.test.ts tests/weekly-stage.test.ts",
    "test:events": "node --experimental-strip-types --test tests/event-rules.test.ts tests/event-readiness.test.ts tests/event-axes.test.ts tests/tile-authoring.test.ts",
    "test:embeds": "node --experimental-strip-types --test tests/discord-embeds.test.ts",
    "test:recap": "node --experimental-strip-types --test tests/recap-derive.test.ts",
    "test:schedule": "node --experimental-strip-types --test tests/schedule-lanes.test.ts",
    "test:admin": "node --experimental-strip-types --test tests/admin-attention.test.ts tests/library-shape.test.ts tests/db-time.test.ts",
    "test:invites": "node --experimental-strip-types --test tests/team-invites.test.ts",
    "test:fees": "node --experimental-strip-types --test tests/fee-rules.test.ts",
    "test:cap": "node --experimental-strip-types --test tests/member-cap.test.ts",
    "test:startproof": "npx tsx --test tests/start-proof.test.ts",
    "test:clog": "npx tsx --test tests/clog-dataset.test.ts && npx tsx --test tests/clog-luck.test.ts",
    "test:activities": "node --experimental-strip-types --test tests/hiscores-activities.test.ts",
    "test:progress": "node --experimental-strip-types --test tests/member-progress.test.ts",
    "test:sets": "node --experimental-strip-types --test tests/collection-sets.test.ts && npx tsx --test tests/tile-csv-sets.test.ts",
    "test:coop": "node --experimental-strip-types --test tests/coop-runs.test.ts",
    "test:counters": "npx tsx --test tests/ingame-counters.test.ts",
    "test:boards": "node --experimental-strip-types --test tests/bingo-lines.test.ts",
    "test:ladder": "node --experimental-strip-types --test tests/ladder-insights.test.ts && npx tsx --test tests/member-breakdown.test.ts",
    "test:weekly": "node --experimental-strip-types --test tests/competition-insights.test.ts",
    "test:cards": "npx tsx --test tests/event-cards.test.ts",
    "test:awards": "node --experimental-strip-types --test tests/competition-awards.test.ts",
    "test:bossgen": "npx tsx --test tests/boss-tile-gen.test.ts",
    "test:moments": "npx tsx --test tests/moments.test.ts && npx tsx --test tests/moments-analytics.test.ts",
    "test:history": "DATABASE_URL=postgres://unused@127.0.0.1:1/unused npx tsx --test tests/stat-history.test.ts"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "@vercel/blob": "^2.0.1",
    "aws4fetch": "^1.0.20",
    "drizzle-orm": "^0.45.1",
    "exceljs": "^4.4.0",
    "jose": "^6.2.3",
    "next": "16.1.6",
    "osrs-json-hiscores": "^2.25.0",
    "pg": "^8.23.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "sharp": "^0.33.5",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@libsql/client": "^0.17.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.21.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.8",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
