# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# uploads
public/uploads/*
!public/uploads/.gitkeep

# sqlite
*.db
*.db-wal
*.db-shm

# data exports / backups (may contain real player data — never commit)
*_backup_*.json
weekly_participants_backup_*.json

# typescript
*.tsbuildinfo
next-env.d.ts

# RuneLite plugin (separate git repo)
/plugin/
sounds/
leagues-bingo-tiles.csv
anvil-reddit-post.md
assets/
docs/examples/leagues-bingo-marathon.csv

# Internal planning notes & local dev files (kept locally, not part of the project)
/anvil_hub_plan.md
/plugin_plan.md
/plugin_clog_plan.md
