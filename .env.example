# Anvil — environment variables
#
# Copy to `.env.local` for local development, or to the `.env` you pass the container
# with `--env-file` / `env_file:` in production (Vercel path: set them in Project →
# Settings → Environment Variables). Full walkthrough: docs/SELF_HOSTING.md.
#
# Scripts that run outside Next.js (drizzle-kit, scripts/*.ts) also read `.env`
# and `.env.local` via a simple loader — see scripts/backfill-clan-members.ts.

# ── Database (SQLite / libSQL) ────────────────────────────────────────────────
# Required. The default is a local SQLite file — no auth token needed.
#   DATABASE_URL=file:/data/anvil.db     (the Docker image defaults to this)
# A remote libSQL endpoint also works (set the token too):
#   DATABASE_URL=libsql://your-db.example.io
#   DATABASE_AUTH_TOKEN=your-auth-token
# (The legacy TURSO_DATABASE_URL / TURSO_AUTH_TOKEN names are still read as a fallback.)
DATABASE_URL=file:./local.db
DATABASE_AUTH_TOKEN=

# ── Session secrets ──────────────────────────────────────────────────────────
# Required in production. Missing values throw at first request so the app
# never runs with a weak default in prod. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=
CAPTAIN_SESSION_SECRET=
PLAYER_SESSION_SECRET=

# ── Plugin codeword HMAC ─────────────────────────────────────────────────────
# Used by GET /api/plugin/config to derive a rotating 6-char codeword the
# plugin displays so moderators can verify a plugin user is real. Required in
# production.
CODEWORD_SECRET=

# ── Cron auth ────────────────────────────────────────────────────────────────
# REQUIRED IN PRODUCTION. Your scheduler sends it as `Authorization: Bearer <CRON_SECRET>`
# to /api/cron/stats, /api/cron/weekly, /api/cron/flush-notifications and
# /api/cron/backup. While it's unset those routes return 500 in production (they are
# never open) — nothing refreshes until you set it. Blank is fine in dev.
CRON_SECRET=

# ── Ops alerts (optional) ────────────────────────────────────────────────────
# A Discord webhook for whoever RUNS this deployment — not a clan channel. The hourly
# /api/cron/errors-digest posts what broke since the last one there: new failures first,
# with counts, the route and the clan. It stays silent when nothing new broke, so the
# channel only speaks when something is wrong.
#
# It is also the BUSINESS channel, not only the alarm: a clan being created and somebody
# signing in for the first time post here as they happen (lib/opsEvents), and a daily digest
# names the clans that signed up and never got going, with their owner's Discord profile and
# email so the follow-up is one click rather than a lookup.
#
# Leave it blank and nothing is lost — all of it is still recorded and still readable at
# /staff/errors and /staff/clans. This only decides whether it comes and finds you.
#
# Blank falls back to DEPLOY_DISCORD_WEBHOOK when the box sets one: if you already have a channel
# where this deployment announces itself, that is an answer to "where do you want to be woken up?"
# and you should not have to give it twice. Set this only to send ops posts somewhere ELSE.
ANVIL_OPS_WEBHOOK_URL=

# ── Public origin ────────────────────────────────────────────────────────────
# Your instance's public URL, e.g. https://bingo.yourclan.com (no trailing slash).
# Used for absolute links and the in-app setup guides at /guide/*. Falls back to the
# origin of DISCORD_REDIRECT_URI when unset.
APP_URL=

# ── Image uploads (object storage) ───────────────────────────────────────────
# All media (proofs, profile and space images) goes through one adapter (src/lib/storage.ts) to an
# S3-compatible store: Cloudflare R2 in production, MinIO (the defaults below) for local dev.

# -- S3 / R2 --
# R2 endpoint, e.g. https://<accountid>.r2.cloudflarestorage.com
S3_ENDPOINT=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=
# Public base the bucket is served from (R2 custom domain or r2.dev). Returned image URLs are
# `${S3_PUBLIC_BASE_URL}/<key>`. Defaults to the API endpoint/bucket (fine for MinIO/dev only).
S3_PUBLIC_BASE_URL=
# Optional per-clan key prefix so one bucket can host many clans (e.g. the clan slug).
S3_KEY_PREFIX=

# Optional, normally unset: one exact host of a former media store whose old URLs should still be
# treated as ours. Never a provider-wide domain.
LEGACY_BLOB_HOST=

# ── Off-box database backup (recommended for self-hosters) ───────────────────
# /api/cron/backup gzips a consistent copy of the local SQLite DB and uploads it once a
# day. It reuses S3_ENDPOINT / S3_ACCESS_KEY_ID / S3_SECRET_ACCESS_KEY above but needs its
# own PRIVATE bucket — a database dump must never sit in the public media bucket, so it
# never falls back to S3_BUCKET. Unset = feature off (the route 200s and does nothing).
S3_BACKUP_BUCKET=
# How many daily copies to keep before pruning (default 14).
BACKUP_RETAIN=

# ── Outgoing email (optional) ────────────────────────────────────────────────
# Reminders to clan owners/admins, e.g. before an event's proof images are deleted (lib/mailer).
# Same names as Anvil.Admin. Two transports; the SES HTTPS API wins when both are set (port 443 is
# never firewalled, SMTP often is). Unset = email off; those reminders still go out as Discord DMs.
MAIL_FROM=
# 1. Amazon SES HTTPS API — an IAM key allowed ses:SendEmail.
SES_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Optional: an SES configuration set, so every send's delivery/bounce is traceable in SES.
SES_CONFIGURATION_SET=
# 2. SMTP, any provider (587 = STARTTLS, 465 = TLS).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ── Discord OAuth (required for player login) ────────────────────────────────
# Create an application at https://discord.com/developers/applications
# Add redirect URL: <APP_URL>/api/auth/discord/callback
# OAuth2 scopes: `identify email`. The email is NOT optional any more — it is the only way to
# reach a clan owner who has closed their DMs, and the operator surfaces show it (see
# ANVIL_OPS_WEBHOOK_URL). Discord asks the person to consent to it at sign-in.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# OAuth2 redirect URL — must exactly match what's registered in the Discord app.
# Example: https://anvil.example.com/api/auth/discord/callback
# For local dev: http://localhost:3000/api/auth/discord/callback
DISCORD_REDIRECT_URI=
# Encrypts players' opt-in `guilds.join` grants at rest (lib/discordUserTokens), used to add them to
# a co-hosted event's Discord server with their team role in one step. At least 32 characters;
# generate with `openssl rand -base64 48`. Unset = auto-join is off and players use the single-use
# invite on their event page instead. Rotating it invalidates stored grants (players re-allow).
DISCORD_TOKEN_KEY=

# ── Twitch (optional, creator-space entry gates) ─────────────────────────────
# Lets a creator space limit an event to its Twitch followers / subscribers (lib/entryGates). Create
# an app at https://dev.twitch.tv/console/apps (category: Website Integration, client type:
# Confidential) and register the redirect URL below. Any of the four unset = every Twitch option is
# hidden from hosts. The host's channel token is stored encrypted with TWITCH_TOKEN_KEY (at least 32
# characters; `openssl rand -base64 48`); viewers' tokens are never stored. Rotating the key means
# hosts reconnect their channel.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# Example: https://anvil.example.com/api/auth/twitch/callback (the APEX host, like the Discord one)
TWITCH_REDIRECT_URI=
TWITCH_TOKEN_KEY=

# ── Twitch bot (optional: `!join` bot process AND the site's stream highlights) ──
# The Anvil bot account's own app + refresh token (deploy/twitch-bot-token.mjs, logged in as the bot).
# The chat bot (bot/twitchChat.ts) needs user:read:chat + user:write:chat; stream highlights
# (lib/highlights — Twitch clips of big moments in streamed events) need clips:edit as well. The site
# keeps its own refreshed copy in twitch_bot_tokens, encrypted with TWITCH_TOKEN_KEY. Unset = no clips.
TWITCH_BOT_CLIENT_ID=
TWITCH_BOT_CLIENT_SECRET=
TWITCH_BOT_REFRESH_TOKEN=
# on / off. Unset = clips everywhere except the owner's preview (beta), whose imported data names real
# streamers' channels. Stream (VOD) links are reads and work either way.
HIGHLIGHTS_CLIPS=

# ── YouTube (optional, creator-space entry gates) ────────────────────────────
# Lets a creator space limit an event to its YouTube subscribers (checked on the viewer's own Google
# sign-in, token revoked straight after) or channel members (a code typed in the host's live chat).
# Google Cloud Console: enable "YouTube Data API v3", configure the OAuth consent screen with the
# scope https://www.googleapis.com/auth/youtube.readonly (a SENSITIVE scope — verification needed
# before the public can use it; add test users meanwhile), then create an OAuth client of type "Web
# application" and register the redirect URL below. Any of the four unset = every YouTube option is
# hidden. Host tokens are encrypted with YOUTUBE_TOKEN_KEY (≥32 chars; `openssl rand -base64 48`);
# rotating it means hosts reconnect.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
# Example: https://anvil.example.com/api/auth/youtube/callback (the APEX host, like the Twitch one)
YOUTUBE_REDIRECT_URI=
YOUTUBE_TOKEN_KEY=

# ── Kick (optional, creator-space entry gates + !join in Kick chat) ───────────
# Lets a creator space limit an event to its Kick followers / subscribers and answer `!join` in its
# Kick chat (lib/kick, lib/gates/kick*). Kick's API cannot look up followers or subs, so Anvil
# records them from Kick's webhooks after the host connects, and viewers prove their Kick account by
# typing a one-time code in the host's chat. Any of the first three unset (or no token key) = every
# Kick option is hidden.
#
# Kick side (https://kick.com/settings/developer, 2FA required) — ideally create the app while logged
# in as the bot account (anvil_osrs), since `!join` replies are posted as the app's bot:
#   Redirect URL:  https://<apex>/api/auth/kick/callback   (one per environment; localhost works)
#   Webhooks:      ON, URL https://<apex>/api/webhooks/kick (one URL per app → one app per env)
#   Scopes asked:  user:read channel:read events:subscribe chat:write (requested at connect time)
KICK_CLIENT_ID=
KICK_CLIENT_SECRET=
# Example: https://anvil.example.com/api/auth/kick/callback (the APEX host)
KICK_REDIRECT_URI=
# Encrypts hosts' Kick tokens and signs the OAuth state. At least 32 characters
# (`openssl rand -base64 48`). Unset = TWITCH_TOKEN_KEY is used. Rotating it means hosts reconnect.
KICK_TOKEN_KEY=
# Optional: send `!join` replies as a specific Kick account (type "user") instead of the app's bot.
# Get it once with scripts/kick-bot-token.mjs while logged in to Kick as that account. Kick rotates
# refresh tokens; the current one is kept (encrypted) in kick_bot_tokens, seeded from this value.
KICK_BOT_REFRESH_TOKEN=
# Optional: milliseconds between `!join` answers per Kick channel (default 30000).
KICK_BOT_COOLDOWN_MS=

# ── Billing: Gumroad (optional; hosted Anvil only — self-hosters leave blank) ─
# Webhook trust: the Ping URL carries ?key=<GUMROAD_WEBHOOK_SECRET>; seller id is a second check.
# GUMROAD_ACCESS_TOKEN (optional) lets the webhook confirm sales and the daily check find lapses.
GUMROAD_WEBHOOK_SECRET=
GUMROAD_SELLER_ID=
GUMROAD_ACCESS_TOKEN=
# Clan plans (lib/plans): product id (matched against the webhook's product_id) and hosted checkout
# URL per tier. A tier with no URL has no upgrade button.
GUMROAD_PRODUCT_BRONZE=
GUMROAD_PRODUCT_SILVER=
GUMROAD_PRODUCT_GOLD=
GUMROAD_URL_BRONZE=
GUMROAD_URL_SILVER=
GUMROAD_URL_GOLD=
# Yearly (a year = 10 months, like Supporter). The checkout link for the tier's yearly option; set the
# _PRODUCT_ id too only if yearly is its own Gumroad product. Unset URL = no yearly button for that tier.
GUMROAD_PRODUCT_BRONZE_YEARLY=
GUMROAD_PRODUCT_SILVER_YEARLY=
GUMROAD_PRODUCT_GOLD_YEARLY=
GUMROAD_URL_BRONZE_YEARLY=
GUMROAD_URL_SILVER_YEARLY=
GUMROAD_URL_GOLD_YEARLY=
# Creator-space plans (lib/creatorCatalog) — their OWN products, separate from the clan ones. The
# product ids are required for the webhook to credit a creator sale (a creator space takes nothing it
# can't identify as a creator product, and a clan product bought for a creator space is refused).
# A tier with no URL has no upgrade button.
GUMROAD_PRODUCT_CREATOR_BRONZE=
GUMROAD_PRODUCT_CREATOR_SILVER=
GUMROAD_PRODUCT_CREATOR_GOLD=
GUMROAD_URL_CREATOR_BRONZE=
GUMROAD_URL_CREATOR_SILVER=
GUMROAD_URL_CREATOR_GOLD=
GUMROAD_PRODUCT_CREATOR_BRONZE_YEARLY=
GUMROAD_PRODUCT_CREATOR_SILVER_YEARLY=
GUMROAD_PRODUCT_CREATOR_GOLD_YEARLY=
GUMROAD_URL_CREATOR_BRONZE_YEARLY=
GUMROAD_URL_CREATOR_SILVER_YEARLY=
GUMROAD_URL_CREATOR_GOLD_YEARLY=
# Anvil Supporter (lib/supporter), the personal membership.
GUMROAD_PRODUCT_SUPPORTER=
GUMROAD_URL_SUPPORTER=

# ── Discord bot (optional, for role sync) ───────────────────────────────────
# Same Discord Application as the OAuth client above — go to Bot tab in the
# developer portal, "Reset Token", paste here. Add the bot to your guild via
# the OAuth2 URL Generator with scope=bot + permissions=Manage Roles, then
# drag the bot's role above the roles it should manage.
#
# Configuration beyond the token is settings-table-driven so admins can edit
# without redeploying:
#   settings.discord_role_sync_enabled   = 'true' to activate
#   settings.discord_guild_id            = your guild's snowflake ID
#   settings.discord_rank_role_map       = {"general":"<roleId>","captain":"..."}
#   settings.discord_default_role_ids    = ["<member-role-id>","<imp-role-id>"]
#   settings.discord_guest_role_ids      = ["<clan-friend-role-id>"]
DISCORD_BOT_TOKEN=
# Optional env override; otherwise the settings table value above wins.
DISCORD_GUILD_ID=
# Shared managed bot (set by the provisioner for hosted clans, not self-hosters). Used only when no
# BYO token (settings.discord_bot_token) and no DISCORD_BOT_TOKEN are set. Precedence:
# settings.discord_bot_token → DISCORD_BOT_TOKEN → ANVIL_SHARED_BOT_TOKEN.
ANVIL_SHARED_BOT_TOKEN=
# ── First-admin Discord ID seed (optional) ──────────────────────────────────
# If set, the first user to sign in via Discord with this ID is auto-promoted
# to 'admin' (used to bootstrap a Discord-linked admin without going through
# the legacy ADMIN_PASSWORD flow). Leave blank once seeded.
ADMIN_DISCORD_ID=

# ── Clan display name (optional env fallback) ────────────────────────────────
# Preferred: set this in the admin UI under /admin/clan → "Clan Settings".
# This env var is a fallback for when the DB setting is unset. It is the name
# shown on the site, in the plugin and in Discord posts — it does NOT have to
# match your in-game clan name.
CLAN_NAME=

# ── In-game clan name (optional env fallback) ────────────────────────────────
# The exact OSRS clan name. The plugin's clan-sync endpoint rejects roster syncs
# whose reported clan name doesn't match this. Leave blank to accept any clan.
# On upgrade, existing installs are backfilled from CLAN_NAME/the clan_name
# setting so the gate keeps working; edit it under /admin/clan → "Clan Settings".
CLAN_INGAME_NAME=

# ── Discord invite (optional env fallback) ───────────────────────────────────
# Preferred: set this in the admin UI under /admin/integrations → "Clan identity".
# Shown as the Discord link in the top nav and home page. The links are hidden
# entirely when neither this nor the DB setting is set.
DISCORD_INVITE_URL=

# ── Member ping role (optional env fallback) ─────────────────────────────────
# Preferred: set this in the admin UI under /admin/integrations → "Clan identity".
# Role pinged when a bingo event starts or finishes. Leave blank for no ping.
DISCORD_MEMBER_ROLE_ID=

# Rate-limit client IP. Set to 1 ONLY when every request reaches the site through Cloudflare (a
# tunnel, or a firewall that drops anything else) — then CF-Connecting-IP is the visitor. Leave it
# unset when Caddy faces the internet directly: a client could send its own and dodge rate limits.
TRUST_CF_CONNECTING_IP=
