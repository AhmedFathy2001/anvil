# Anvil — environment variables
#
# Copy to `.env.local` for local development, or set these in your deployment
# platform (Vercel project settings → Environment Variables) for production.
#
# Scripts that run outside Next.js (drizzle-kit, scripts/*.ts) also read `.env`
# and `.env.local` via a simple loader — see scripts/backfill-clan-members.ts.

# ── Database (Turso / libSQL) ─────────────────────────────────────────────────
# Required. `TURSO_*` names are preferred; `DATABASE_*` work as fallbacks.
TURSO_DATABASE_URL=libsql://your-db.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token

# ── Session secrets ──────────────────────────────────────────────────────────
# Required in production. Missing values throw at first request so the app
# never runs with a weak default in prod. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=
CAPTAIN_SESSION_SECRET=
PLAYER_SESSION_SECRET=

# ── Plugin codeword HMAC ─────────────────────────────────────────────────────
# Used by GET /api/plugin/config to derive a rotating 6-char codeword the
# plugin displays so moderators can verify a plugin user is real. Required in
# production.
CODEWORD_SECRET=

# ── Cron auth (Vercel cron) ──────────────────────────────────────────────────
# Vercel passes this as `Authorization: Bearer <CRON_SECRET>` to the cron routes
# at /api/cron/stats and /api/cron/weekly. Leave blank to disable the check
# (not recommended in production).
CRON_SECRET=

# ── Image uploads (Vercel Blob) ──────────────────────────────────────────────
# Required for drop-proof screenshots uploaded via /api/upload. Get this from
# the Vercel dashboard → Storage → Blob.
BLOB_READ_WRITE_TOKEN=

# ── First-admin seed (optional) ──────────────────────────────────────────────
# If the users table is empty, the admin login route accepts this password
# with any username and creates a bootstrap admin. Leave blank after you've
# seeded the first admin through the UI.
ADMIN_PASSWORD=

# ── Discord OAuth (required for player login) ────────────────────────────────
# Create an application at https://discord.com/developers/applications
# Add redirect URL: <APP_URL>/api/auth/discord/callback
# OAuth2 scope: identify (email optional)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# OAuth2 redirect URL — must exactly match what's registered in the Discord app.
# Example: https://anvil.example.com/api/auth/discord/callback
# For local dev: http://localhost:3000/api/auth/discord/callback
DISCORD_REDIRECT_URI=

# ── First-admin Discord ID seed (optional) ──────────────────────────────────
# If set, the first user to sign in via Discord with this ID is auto-promoted
# to 'admin' (used to bootstrap a Discord-linked admin without going through
# the legacy ADMIN_PASSWORD flow). Leave blank once seeded.
ADMIN_DISCORD_ID=

# ── Clan name (optional env fallback) ────────────────────────────────────────
# Preferred: set this in the admin UI under /admin/clan → "Clan Settings".
# This env var is a fallback for when the DB setting is unset. The plugin's
# clan-sync endpoint rejects syncs whose reported clan name doesn't match.
# Leave blank to accept any clan.
CLAN_NAME=

# ── Observability (optional Sentry) ──────────────────────────────────────────
# If set, src/lib/logger.ts forwards warn+error events to Sentry via a dynamic
# `@sentry/nextjs` import. The package is NOT installed by default — run
#   npm install @sentry/nextjs
# before setting this, or the import will silently fail (fine, logs still go to
# stdout).
SENTRY_DSN=
