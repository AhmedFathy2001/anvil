# Anvil — environment variables
#
# Copy to `.env.local` for local development, or to the `.env` you pass the container
# with `--env-file` / `env_file:` in production (Vercel path: set them in Project →
# Settings → Environment Variables). Full walkthrough: docs/SELF_HOSTING.md.
#
# Scripts that run outside Next.js (drizzle-kit, scripts/*.ts) also read `.env`
# and `.env.local` via a simple loader — see scripts/backfill-clan-members.ts.

# ── Database (SQLite / libSQL) ────────────────────────────────────────────────
# Required. The default is a local SQLite file — no auth token needed.
#   DATABASE_URL=file:/data/anvil.db     (the Docker image defaults to this)
# A remote libSQL endpoint also works (set the token too):
#   DATABASE_URL=libsql://your-db.example.io
#   DATABASE_AUTH_TOKEN=your-auth-token
# (The legacy TURSO_DATABASE_URL / TURSO_AUTH_TOKEN names are still read as a fallback.)
DATABASE_URL=file:./local.db
DATABASE_AUTH_TOKEN=

# ── Session secrets ──────────────────────────────────────────────────────────
# Required in production. Missing values throw at first request so the app
# never runs with a weak default in prod. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=
CAPTAIN_SESSION_SECRET=
PLAYER_SESSION_SECRET=

# ── Plugin codeword HMAC ─────────────────────────────────────────────────────
# Used by GET /api/plugin/config to derive a rotating 6-char codeword the
# plugin displays so moderators can verify a plugin user is real. Required in
# production.
CODEWORD_SECRET=

# ── Cron auth ────────────────────────────────────────────────────────────────
# REQUIRED IN PRODUCTION. Your scheduler sends it as `Authorization: Bearer <CRON_SECRET>`
# to /api/cron/stats, /api/cron/weekly, /api/cron/flush-notifications and
# /api/cron/backup. While it's unset those routes return 500 in production (they are
# never open) — nothing refreshes until you set it. Blank is fine in dev.
CRON_SECRET=

# ── Ops alerts (optional) ────────────────────────────────────────────────────
# A Discord webhook for whoever RUNS this deployment — not a clan channel. The hourly
# /api/cron/errors-digest posts what broke since the last one there: new failures first,
# with counts, the route and the clan. It stays silent when nothing new broke, so the
# channel only speaks when something is wrong.
#
# It is also the BUSINESS channel, not only the alarm: a clan being created and somebody
# signing in for the first time post here as they happen (lib/opsEvents), and a daily digest
# names the clans that signed up and never got going, with their owner's Discord profile and
# email so the follow-up is one click rather than a lookup.
#
# Leave it blank and nothing is lost — all of it is still recorded and still readable at
# /staff/errors and /staff/clans. This only decides whether it comes and finds you.
#
# Blank falls back to DEPLOY_DISCORD_WEBHOOK when the box sets one: if you already have a channel
# where this deployment announces itself, that is an answer to "where do you want to be woken up?"
# and you should not have to give it twice. Set this only to send ops posts somewhere ELSE.
ANVIL_OPS_WEBHOOK_URL=

# ── Public origin ────────────────────────────────────────────────────────────
# Your instance's public URL, e.g. https://bingo.yourclan.com (no trailing slash).
# Used for absolute links and the in-app setup guides at /guide/*. Falls back to the
# origin of DISCORD_REDIRECT_URI when unset.
APP_URL=

# ── Image uploads (object storage) ───────────────────────────────────────────
# Drop-proof screenshots + fee proofs go through one storage adapter (src/lib/storage.ts).
# Two drivers; pick with STORAGE_DRIVER, or leave blank to auto-detect (S3 when S3_BUCKET
# is set, else Vercel Blob).
#   STORAGE_DRIVER=s3            -> any S3-compatible store (recommend Cloudflare R2)
#   STORAGE_DRIVER=vercel-blob   -> @vercel/blob (zero-config on Vercel)
STORAGE_DRIVER=

# -- S3 / R2 driver (self-hosted / Docker) --
# R2 endpoint, e.g. https://<accountid>.r2.cloudflarestorage.com
S3_ENDPOINT=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=
# Public base the bucket is served from (R2 custom domain or r2.dev). Returned image URLs are
# `${S3_PUBLIC_BASE_URL}/<key>`. Defaults to the API endpoint/bucket (fine for MinIO/dev only).
S3_PUBLIC_BASE_URL=
# Optional per-clan key prefix so one bucket can host many clans (e.g. the clan slug).
S3_KEY_PREFIX=

# -- Vercel Blob driver --
# Required only when STORAGE_DRIVER=vercel-blob. Vercel dashboard → Storage → Blob.
BLOB_READ_WRITE_TOKEN=

# ── Off-box database backup (recommended for self-hosters) ───────────────────
# /api/cron/backup gzips a consistent copy of the local SQLite DB and uploads it once a
# day. It reuses S3_ENDPOINT / S3_ACCESS_KEY_ID / S3_SECRET_ACCESS_KEY above but needs its
# own PRIVATE bucket — a database dump must never sit in the public media bucket, so it
# never falls back to S3_BUCKET. Unset = feature off (the route 200s and does nothing).
S3_BACKUP_BUCKET=
# How many daily copies to keep before pruning (default 14).
BACKUP_RETAIN=

# ── Discord OAuth (required for player login) ────────────────────────────────
# Create an application at https://discord.com/developers/applications
# Add redirect URL: <APP_URL>/api/auth/discord/callback
# OAuth2 scopes: `identify email`. The email is NOT optional any more — it is the only way to
# reach a clan owner who has closed their DMs, and the operator surfaces show it (see
# ANVIL_OPS_WEBHOOK_URL). Discord asks the person to consent to it at sign-in.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# OAuth2 redirect URL — must exactly match what's registered in the Discord app.
# Example: https://anvil.example.com/api/auth/discord/callback
# For local dev: http://localhost:3000/api/auth/discord/callback
DISCORD_REDIRECT_URI=

# ── Discord bot (optional, for role sync) ───────────────────────────────────
# Same Discord Application as the OAuth client above — go to Bot tab in the
# developer portal, "Reset Token", paste here. Add the bot to your guild via
# the OAuth2 URL Generator with scope=bot + permissions=Manage Roles, then
# drag the bot's role above the roles it should manage.
#
# Configuration beyond the token is settings-table-driven so admins can edit
# without redeploying:
#   settings.discord_role_sync_enabled   = 'true' to activate
#   settings.discord_guild_id            = your guild's snowflake ID
#   settings.discord_rank_role_map       = {"general":"<roleId>","captain":"..."}
#   settings.discord_default_role_ids    = ["<member-role-id>","<imp-role-id>"]
#   settings.discord_guest_role_ids      = ["<clan-friend-role-id>"]
DISCORD_BOT_TOKEN=
# Optional env override; otherwise the settings table value above wins.
DISCORD_GUILD_ID=
# Shared managed bot (set by the provisioner for hosted clans, not self-hosters). Used only when no
# BYO token (settings.discord_bot_token) and no DISCORD_BOT_TOKEN are set. Precedence:
# settings.discord_bot_token → DISCORD_BOT_TOKEN → ANVIL_SHARED_BOT_TOKEN.
ANVIL_SHARED_BOT_TOKEN=
# ── First-admin Discord ID seed (optional) ──────────────────────────────────
# If set, the first user to sign in via Discord with this ID is auto-promoted
# to 'admin' (used to bootstrap a Discord-linked admin without going through
# the legacy ADMIN_PASSWORD flow). Leave blank once seeded.
ADMIN_DISCORD_ID=

# ── Clan display name (optional env fallback) ────────────────────────────────
# Preferred: set this in the admin UI under /admin/clan → "Clan Settings".
# This env var is a fallback for when the DB setting is unset. It is the name
# shown on the site, in the plugin and in Discord posts — it does NOT have to
# match your in-game clan name.
CLAN_NAME=

# ── In-game clan name (optional env fallback) ────────────────────────────────
# The exact OSRS clan name. The plugin's clan-sync endpoint rejects roster syncs
# whose reported clan name doesn't match this. Leave blank to accept any clan.
# On upgrade, existing installs are backfilled from CLAN_NAME/the clan_name
# setting so the gate keeps working; edit it under /admin/clan → "Clan Settings".
CLAN_INGAME_NAME=

# ── Discord invite (optional env fallback) ───────────────────────────────────
# Preferred: set this in the admin UI under /admin/integrations → "Clan identity".
# Shown as the Discord link in the top nav and home page. The links are hidden
# entirely when neither this nor the DB setting is set.
DISCORD_INVITE_URL=

# ── Member ping role (optional env fallback) ─────────────────────────────────
# Preferred: set this in the admin UI under /admin/integrations → "Clan identity".
# Role pinged when a bingo event starts or finishes. Leave blank for no ping.
DISCORD_MEMBER_ROLE_ID=

