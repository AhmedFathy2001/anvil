# /opt/anvil/site.env — the shared deployment's environment.
#
# WHAT IS NOT HERE ANY MORE. Every per-clan variable is gone: CLAN_NAME, CLAN_INGAME_NAME,
# CLAN_SLUG, MEMBER_CAP, APP_URL, S3_KEY_PREFIX and the per-clan Discord credentials. A clan is a
# row now, so those are columns and settings, read per request from whichever clan the Host names.
# One file for the whole deployment.

# ── Identity of the deployment ────────────────────────────────────────────────────────────────
# The apex everything hangs off. A clan lives at <slug>.$ANVIL_APEX_DOMAIN; the apex itself is
# clanless and serves the directory and /staff. Used to STRIP a suffix and recognise the apex —
# never to decide what a host is allowed to be, which is a database lookup.
ANVIL_APEX_DOMAIN=anvilosrs.com

# Extra hosts that are also "the apex" — a staging or preview apex alongside the real one.
# Comma-separated, optional. `www.<apex>` is already included without being listed.
#ANVIL_APEX_ALIASES=

# ── Database ──────────────────────────────────────────────────────────────────────────────────
# Set by compose from POSTGRES_PASSWORD; listed here so a bare `docker run` knows it is required.
#DATABASE_URL=postgres://anvil:...@anvil-postgres:5432/anvil

# ── Sessions ──────────────────────────────────────────────────────────────────────────────────
# Signs admin_session. Changing it signs everyone out — which is what happens at cutover anyway,
# since the old per-container secrets cannot verify here.
ADMIN_SESSION_SECRET=

# The cookie's domain is DERIVED from ANVIL_APEX_DOMAIN (".<apex>"), not configured here — so one
# sign-in on the apex is a sign-in on every clan beneath it, and the two can never drift apart.

# ── Discord ───────────────────────────────────────────────────────────────────────────────────
# ONE app for the whole deployment. Login runs on the apex — one app means one registered callback
# — and hands the session back to the clan the person came from.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=https://anvilosrs.com/api/auth/discord/callback
DISCORD_BOT_TOKEN=

# ── Bootstrap ─────────────────────────────────────────────────────────────────────────────────
# Two axes, two variables, deliberately not one.
#
# ADMIN_DISCORD_ID becomes staff of the CLAN they sign in to — the escape hatch that keeps a clan
# administrable. The first such grant in a clan is its owner.
ADMIN_DISCORD_ID=

# PLATFORM_ROOT_DISCORD_ID becomes platform root — /staff, clan lifecycle, platform bans. Nothing
# else writes platform_role, so without this there is no first operator and /staff is unreachable
# by everyone. Promotes only from 'none', so stepping someone down is not undone at their next
# login. A clan role must never grant platform capability, which is why this is its own variable.
PLATFORM_ROOT_DISCORD_ID=

# ── Cron ──────────────────────────────────────────────────────────────────────────────────────
# Bearer for /api/cron/*. Read by deploy/cron/site-cron.sh from this same file.
CRON_SECRET=

# ── Storage ───────────────────────────────────────────────────────────────────────────────────
# Media — PUBLIC bucket (proof screenshots, clan images).
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto

# Backups — a SEPARATE, PRIVATE bucket. Never the media bucket: a database dump holds every clan's
# data and must not be publicly reachable. Missing config means backups are simply off.
S3_BACKUP_BUCKET=
# Namespace inside that bucket. The deployment's, not a clan's — one dump covers every clan.
S3_KEY_PREFIX=anvil
BACKUP_RETAIN=14
