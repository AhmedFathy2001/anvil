# Anvil crons. One app, one database, so each job runs once — not once per clan.
# Install to /etc/cron.d/anvil-cron, root-owned, 0644. Pairs with /opt/anvil/cron-anvil.sh, which
# curls https://anvilosrs.com/api/cron/<job> with the CRON_SECRET from /opt/anvil/site.env.
#
# deploy.sh does NOT install this — the box's cron is hand-managed. After editing here, copy both
# files to the box and it takes effect on cron's next minute (see README).
#
#   stats                every 15 min   — hiscores sweep; self-limiting (oldest-first, bounded)
#   weekly               every 15 min   — competition lifecycle: enrol, flip status, announce
#   flush-notifications  every minute   — the debounce backstop, plus scheduled start/end posts
#   forge-consume        every 5 min    — drain the Forge data-plane queue
#   backup               daily          — pg_dump to object storage
#   discord-commands     daily          — reconcile the shared bot's slash commands with the code
*/15 * * * * root /opt/anvil/cron-anvil.sh stats
*/15 * * * * root /opt/anvil/cron-anvil.sh weekly
*    * * * * root /opt/anvil/cron-anvil.sh flush-notifications
*/5  * * * * root /opt/anvil/cron-anvil.sh forge-consume
17 4 * * *   root /opt/anvil/cron-anvil.sh backup
40 4 * * *   root /opt/anvil/cron-anvil.sh discord-commands
